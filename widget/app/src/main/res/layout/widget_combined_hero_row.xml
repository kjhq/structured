<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/hero_card_background"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12"
    android:paddingTop="@dimen/space_10"
    android:paddingBottom="@dimen/space_10"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginBottom="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/combined_hero_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="@dimen/space_8"
            android:contentDescription="@string/cd_task_color" />

        <TextView
            android:id="@+id/combined_hero_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Widget.Display"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/combined_hero_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:background="@drawable/status_badge_bg"
            android:textAppearance="@style/TextAppearance.Widget.Badge"
            android:text="NOW"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_2">

        <TextView
            android:id="@+id/combined_hero_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Widget.Caption"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/combined_hero_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Widget.Caption"
            android:maxLines="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/combined_hero_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="@dimen/space_6"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/hero_progress_drawable" />
</LinearLayout>
