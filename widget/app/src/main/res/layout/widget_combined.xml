<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_padding_h"
    android:paddingEnd="@dimen/widget_padding_h"
    android:paddingTop="@dimen/widget_padding_v"
    android:paddingBottom="@dimen/widget_padding_v"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_header_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Widget.Eyebrow"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="TODAY" />

            <TextView
                android:id="@+id/widget_header_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_6"
                android:textAppearance="@style/TextAppearance.Widget.Caption"
                android:maxLines="1"
                android:text="" />

            <ImageView
                android:id="@+id/widget_header_open"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:contentDescription="@string/refresh_description"
                android:src="@drawable/ic_refresh"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_header_day_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_header_progress_h"
            android:layout_marginTop="@dimen/space_4"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/day_progress_drawable" />
    </LinearLayout>

    <ListView
        android:id="@+id/combined_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:paddingBottom="@dimen/space_4"
        android:clipToPadding="false" />
</LinearLayout>
