{
	# Local/dev: cleartext HTTP to api on :8003 (no TLS cert required).
	# Production: put real TLS hostnames here and terminate HTTPS.
	:8003 {
		# Block MCP on the public listener — bot reaches api:8000 internally.
		@mcp path /mcp /mcp/*
		respond @mcp 404

		reverse_proxy api:8000
	}

	# Optional HTTPS listener (self-signed for LAN testing).
	:8443 {
		tls internal
		@mcp path /mcp /mcp/*
		respond @mcp 404
		reverse_proxy api:8000
	}
}
